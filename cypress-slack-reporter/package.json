{
  "name": "cypress-slack-reporter",
  "version": "2.0.1",
  "description": "Send Cypress and Mocha test results to Slack",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "cypress-slack-reporter": "dist/index.js"
  },
  "keywords": [
    "cypress",
    "slack",
    "reporter",
    "mocha",
    "mochawesome"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YOU54F/cypress-plugins.git",
    "directory": "cypress-slack-reporter"
  },
  "author": "Yousaf Nabi",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@slack/web-api": "^8.3.0",
    "@slack/webhook": "^8.0.2",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "globby": "^11.1.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^22.7.9",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "typescript": "^5.6.3"
  },
  "scripts": {
    "build": "tsc",
    "test": "jest --runInBand",
    "prepublishOnly": "npm run build"
  }
